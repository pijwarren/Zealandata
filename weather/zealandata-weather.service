[Unit]
Description=Zealandata wind + waves + temp field fetch (see weather/README.md)

[Service]
Type=oneshot
User=pj
WorkingDirectory=/home/pj/zealandata/weather
# All three refresh on the same ~3h GFS/WW3 cadence, so one timer trigger
# runs them in sequence -- see zealandata-weather-currents.service for the
# separate, not-on-a-timer currents fetch (that data doesn't change).
ExecStart=/home/pj/.local/node-v24.21.0-linux-arm64/bin/node fetch_wind.mjs
ExecStart=/home/pj/.local/node-v24.21.0-linux-arm64/bin/node fetch_waves.mjs
ExecStart=/home/pj/.local/node-v24.21.0-linux-arm64/bin/node fetch_temp.mjs
