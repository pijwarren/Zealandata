[Unit]
Description=Zealandata wind (all levels) + waves + temp field fetch (see weather/README.md)

[Service]
Type=oneshot
User=pj
WorkingDirectory=/home/pj/zealandata/weather
# All of these refresh on the same ~3h GFS/WW3 cadence, so one timer
# trigger runs them in sequence -- see zealandata-weather-currents.service
# for the separate, not-on-a-timer currents fetch (that data doesn't
# change). Each "-" prefix makes that invocation's exit code non-fatal to
# the unit (still logged, still counted per-invocation in `systemctl
# status`) -- with ten of these chained, one level's transient 404 (a GFS
# run not fully published yet) shouldn't block the other nine. (Not using
# Environment=NODE=... + ${NODE} here -- this system's systemd doesn't
# expand it in the executable-path position, only in arguments, so it
# fails with 203/EXEC; spelling the path out ten times is the reliable
# option.)
ExecStart=-/home/pj/.local/node-v24.21.0-linux-arm64/bin/node fetch_wind.mjs surface
ExecStart=-/home/pj/.local/node-v24.21.0-linux-arm64/bin/node fetch_wind.mjs 1000hPa
ExecStart=-/home/pj/.local/node-v24.21.0-linux-arm64/bin/node fetch_wind.mjs 850hPa
ExecStart=-/home/pj/.local/node-v24.21.0-linux-arm64/bin/node fetch_wind.mjs 700hPa
ExecStart=-/home/pj/.local/node-v24.21.0-linux-arm64/bin/node fetch_wind.mjs 500hPa
ExecStart=-/home/pj/.local/node-v24.21.0-linux-arm64/bin/node fetch_wind.mjs 250hPa
ExecStart=-/home/pj/.local/node-v24.21.0-linux-arm64/bin/node fetch_wind.mjs 70hPa
ExecStart=-/home/pj/.local/node-v24.21.0-linux-arm64/bin/node fetch_wind.mjs 10hPa
ExecStart=-/home/pj/.local/node-v24.21.0-linux-arm64/bin/node fetch_waves.mjs
ExecStart=-/home/pj/.local/node-v24.21.0-linux-arm64/bin/node fetch_temp.mjs
