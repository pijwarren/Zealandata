[Unit]
Description=Zealandata media server
After=network.target sound.target zealandata-splash.service

[Service]
# Explicitly stops the boot splash the moment this service starts, rather
# than a mutual Conflicts= declaration (see zealandata-splash.service for
# why that was actually unreliable, not just untidy). The leading "-" makes
# this non-fatal if the splash isn't installed/running at all.
ExecStartPre=-/usr/bin/systemctl stop zealandata-splash.service
# Same VT binding as zealandata-splash.service, and for the same reason:
# the mpv process this spawns needs a real controlling TTY to do DRM/KMS
# VT-switching, which a systemd service doesn't get by default. Inherited
# by the mpv child process automatically (subprocess.Popen inherits stdio).
StandardInput=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
# Adjust User/paths to match your Pi setup.
User=pj
WorkingDirectory=/home/pj/zealandata
Environment=ZEALANDATA_MEDIA_DIR=/home/pj/media
# Environment=ZEALANDATA_PORT=8000
# Set to 1 for headless DRM output (Raspberry Pi OS Lite, no desktop).
# Leave at 0 and set ZEALANDATA_DISPLAY if you're running a desktop session.
Environment=ZEALANDATA_USE_DRM=1
# Environment=ZEALANDATA_DISPLAY=:0
Environment=ZEALANDATA_SCREENSAVER_ENABLED=1
# Environment=ZEALANDATA_SCREENSAVER_MUTED=1
# When a video ends: pause on the last frame (scrubbable) by default, or
# loop indefinitely instead if set to 1. Off (0) by default.
# Environment=ZEALANDATA_LOOP_SELECTED=1
# If something's left PAUSED (not stopped) this long with no interaction,
# auto-stop it and return to the screensaver. Off by default; 300 = 5 min.
Environment=ZEALANDATA_IDLE_TIMEOUT_ENABLED=1
Environment=ZEALANDATA_IDLE_TIMEOUT_SECONDS=300
# Image sequence folders (frame_0001.png, frame_0002.png, ...) need at
# least this many frames to be recognized, converted at this frame rate.
Environment=ZEALANDATA_SEQUENCE_MIN_FRAMES=3
Environment=ZEALANDATA_SEQUENCE_FPS=1
# Unlocks admin mode (renaming videos) in the web UI, gated by this
# 4-digit PIN. Unset by default -- admin mode is unavailable until set.
Environment=ZEALANDATA_ADMIN_PIN=1234

# Held up (via mpv's loadfile, not a separate process) any time nothing
# else is queued -- server startup, an explicit stop, screensaver off --
# so the Linux console is never what's actually on screen. Off unless you
# set an image path (see zealandata-splash.service for the separate
# boot-time version of this, covering the moment before this service
# itself has even started).
Environment=ZEALANDATA_LOADING_IMAGE=/home/pj/zealandata/loading.png
ExecStart=/usr/bin/python3 /home/pj/zealandata/server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
