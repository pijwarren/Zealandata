[Unit]
Description=PiFlix media server
After=network.target sound.target

[Service]
# Adjust User/paths to match your Pi setup.
User=pi
WorkingDirectory=/home/pi/piflix
Environment=PIFLIX_MEDIA_DIR=/home/pi/media
# Set to 1 for headless DRM output (Raspberry Pi OS Lite, no desktop).
# Leave at 0 and set PIFLIX_DISPLAY if you're running a desktop session.
Environment=PIFLIX_USE_DRM=1
# Environment=PIFLIX_DISPLAY=:0
# Optional: loop a video file, or a directory of images, on the HDMI
# output whenever nothing is playing. Leave unset to disable.
# Environment=PIFLIX_SCREENSAVER=/home/pi/media/_screensaver/loop.mp4
ExecStart=/usr/bin/python3 /home/pi/piflix/server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
