# Generated at runtime — regenerated automatically on first scan/request,
# don't belong in version control (and thumbnails/sequence_cache can get
# large fast).
static/thumbnails/
static/hero_thumbnails/
static/sequence_cache/
preview.jpg
preview_raw.jpg
progress.json
hero.json
titles.json
descriptions.json
play_counts.json
mapping.json
admin_pin.json
wind_field.bin
wind_field.bin.tmp
waves_field.bin
waves_field.bin.tmp
currents_field.bin
currents_field.bin.tmp
temp_field.bin
temp_field.bin.tmp

# Compiled native projector -- built on the Pi from projector.c by its
# Makefile, and architecture-specific, so it never belongs in the repo.
projector/projector

# Runtime logs
*.log

# Cached upstream Natural Earth data for weather/gen_coastline.mjs --
# ~10MB, regenerate coastline_uv.h from it rather than tracking the source.
weather/vendor/natural_earth/

# Python
__pycache__/
*.pyc

# Editor/OS cruft
.DS_Store
*.swp

# Your actual media library does NOT belong in this repo — it's typically
# far too large for git, and doesn't need version history. Keep it on the
# Pi's filesystem wherever ZEALANDATA_MEDIA_DIR points, entirely separate
# from this repo.

# The frozen view library thumbnails are rendered through -- captured
# from this projector's own calibration, so like mapping.json it describes
# this installation rather than the code.
thumbnail_view.json

# Plain extracted frames -- the source images projected thumbnails are
# rendered from. Regenerated from the videos on demand.
static/frames/
